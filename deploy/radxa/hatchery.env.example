# Set actual paths from ls -l /dev/serial/by-id and v4l2-ctl --list-devices.
# Empty hardware paths deliberately prevent startup; COM5 is not a Linux path.
# Optional display name and unique ID; never use the HTTP port as identity.
# HATCHERY_DEVICE_NAME=George-Radxa
# HATCHERY_DEVICE_ID=hatchery-radxa-01
HATCHERY_SERIAL_PORT=
# Optional initial polling IDs; leave empty to scan from Parameters / Calibration.
HATCHERY_SERVO_IDS=
HATCHERY_BAUD=1000000
HATCHERY_CAMERA_DEVICE=
HATCHERY_CAMERA_ROTATE=90
HATCHERY_CONFIGURE_SENSOR=0
HATCHERY_MEDIA_HOST=127.0.0.1
HATCHERY_CAMERA_HTTP_PORT=8080
HATCHERY_SIGNALLING_PORT=8443
HATCHERY_MAINTENANCE_HTTP_PORT=8088
HATCHERY_BENCH_CONTROL=0
HATCHERY_PARAMS=/etc/robot/robotd.toml
# Socket paths default to /run/robot in systemd, user state directory for manual runs.

# Official configd owns NetworkManager / BlueZ configuration.
# HATCHERY_CONFIG_SOCKET=/run/configd.sock
# Optional V4L2 ISP control node, only after checking its capabilities.
# HATCHERY_CAMERA_ISP_DEVICE=/dev/v4l-subdevX

# Existing Rockchip camera engine control socket (no second ISP engine).
# HATCHERY_RKAIQ_SOCKET=/tmp/UNIX.domain0
# Optional API2 controls inside the same 3A service process; see docs/CAMERA_CONTROLS.md.
# HATCHERY_RKAIQ_CONTROL_SOCKET=/run/robot/rkaiq-control.sock
# HATCHERY_RKAIQ_IQ_DIR=/etc/iqfiles/
