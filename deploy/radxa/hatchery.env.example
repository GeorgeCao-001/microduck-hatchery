# Set actual paths from ls -l /dev/serial/by-id and v4l2-ctl --list-devices.
# Empty hardware paths deliberately prevent startup; COM5 is not a Linux path.
HATCHERY_SERIAL_PORT=
# Optional initial polling IDs; leave empty to scan from Parameters / Calibration.
HATCHERY_SERVO_IDS=
HATCHERY_BAUD=1000000
HATCHERY_CAMERA_DEVICE=
HATCHERY_CAMERA_ROTATE=90
HATCHERY_CONFIGURE_SENSOR=0
HATCHERY_MEDIA_HOST=127.0.0.1
HATCHERY_CAMERA_HTTP_PORT=8080
HATCHERY_SIGNALLING_PORT=8443
HATCHERY_MAINTENANCE_HTTP_PORT=8088
HATCHERY_BENCH_CONTROL=0
HATCHERY_PARAMS=/etc/robot/robotd.toml
# Socket paths default to /run/robot in systemd, user state directory for manual runs.
